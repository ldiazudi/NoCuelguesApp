<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Apariencias de texto -->

    <style name="TextAppearance.NoCuelgues" parent="">
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">@font/space_grotesk_medium</item>
        <item name="fontFamily">@font/space_grotesk_medium</item>
    </style>

    <style name="TextAppearance.NoCuelgues.Display">
        <item name="android:textSize">32sp</item>
        <item name="android:fontFamily">@font/space_grotesk_bold</item>
        <item name="fontFamily">@font/space_grotesk_bold</item>
        <item name="android:letterSpacing">-0.03</item>
    </style>

    <style name="TextAppearance.NoCuelgues.Headline">
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">@font/space_grotesk_bold</item>
        <item name="fontFamily">@font/space_grotesk_bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.NoCuelgues.DaysNumber">
        <item name="android:textSize">34sp</item>
        <item name="android:fontFamily">@font/space_grotesk_bold</item>
        <item name="fontFamily">@font/space_grotesk_bold</item>
        <item name="android:letterSpacing">-0.03</item>
    </style>

    <style name="TextAppearance.NoCuelgues.StatNumber">
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">@font/space_grotesk_bold</item>
        <item name="fontFamily">@font/space_grotesk_bold</item>
    </style>

    <style name="TextAppearance.NoCuelgues.Title">
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">@font/space_grotesk_bold</item>
        <item name="fontFamily">@font/space_grotesk_bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.NoCuelgues.Input">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/space_grotesk_semibold</item>
        <item name="fontFamily">@font/space_grotesk_semibold</item>
    </style>

    <style name="TextAppearance.NoCuelgues.Button">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/space_grotesk_bold</item>
        <item name="fontFamily">@font/space_grotesk_bold</item>
    </style>

    <style name="TextAppearance.NoCuelgues.Option">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/space_grotesk_bold</item>
        <item name="fontFamily">@font/space_grotesk_bold</item>
    </style>

    <style name="TextAppearance.NoCuelgues.Body">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.NoCuelgues.BodyStrong">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/space_grotesk_semibold</item>
        <item name="fontFamily">@font/space_grotesk_semibold</item>
    </style>

    <style name="TextAppearance.NoCuelgues.Caption">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.NoCuelgues.Label">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/space_grotesk_bold</item>
        <item name="fontFamily">@font/space_grotesk_bold</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextAppearance.NoCuelgues.Badge">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">@font/space_grotesk_bold</item>
        <item name="fontFamily">@font/space_grotesk_bold</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Formas -->

    <style name="ShapeAppearance.NoCuelgues.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_sm</item>
    </style>

    <style name="ShapeAppearance.NoCuelgues.ExtraSmall" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_xs</item>
    </style>

    <!-- Componentes -->

    <style name="Widget.NoCuelgues.Button" parent="">
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">@dimen/space_lg</item>
        <item name="android:paddingEnd">@dimen/space_xl</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">@dimen/shadow</item>
        <item name="android:drawablePadding">@dimen/space_sm</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.NoCuelgues.Button</item>
        <item name="android:textColor">@color/ink</item>
        <item name="drawableTint">@color/ink</item>
        <item name="android:background">@drawable/bg_button_primary</item>
    </style>

    <style name="Widget.NoCuelgues.Button.Surface">
        <item name="android:background">@drawable/bg_button_surface</item>
    </style>

    <style name="Widget.NoCuelgues.Button.Danger">
        <item name="android:background">@drawable/bg_button_danger</item>
        <item name="android:textColor">@color/surface</item>
        <item name="drawableTint">@color/surface</item>
    </style>

    <style name="Widget.NoCuelgues.Button.Small">
        <item name="android:layout_height">@dimen/touch_target</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textSize">14.5sp</item>
    </style>

    <style name="Widget.NoCuelgues.Button.Small.Surface">
        <item name="android:background">@drawable/bg_button_surface</item>
    </style>

    <style name="Widget.NoCuelgues.Button.Small.Danger">
        <item name="android:background">@drawable/bg_button_danger</item>
        <item name="android:textColor">@color/surface</item>
        <item name="drawableTint">@color/surface</item>
    </style>

    <style name="Widget.NoCuelgues.IconButton" parent="">
        <item name="android:layout_width">@dimen/touch_target</item>
        <item name="android:layout_height">@dimen/touch_target</item>
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:paddingEnd">@dimen/shadow_sm</item>
        <item name="android:paddingBottom">@dimen/shadow_sm</item>
        <item name="android:scaleType">center</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="tint">@color/ink</item>
    </style>

    <style name="Widget.NoCuelgues.FieldLabel" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textAppearance">@style/TextAppearance.NoCuelgues.Label</item>
    </style>

    <style name="Widget.NoCuelgues.FieldCounter" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.NoCuelgues.Caption</item>
    </style>

    <style name="Widget.NoCuelgues.FieldError" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:drawablePadding">@dimen/space_xs</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textAppearance">@style/TextAppearance.NoCuelgues.BodyStrong</item>
        <item name="android:textColor">@color/error</item>
        <item name="drawableTint">@color/error</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="Widget.NoCuelgues.Input" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:minHeight">@dimen/field_height</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">@dimen/field_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/field_padding_end</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">@dimen/shadow</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textAppearance">@style/TextAppearance.NoCuelgues.Input</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:textCursorDrawable">@null</item>
    </style>

    <style name="Widget.NoCuelgues.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/selector_chip_background</item>
        <item name="chipStrokeColor">@color/ink</item>
        <item name="chipStrokeWidth">@dimen/stroke_thin</item>
        <item name="chipMinHeight">36dp</item>
        <item name="chipIconVisible">true</item>
        <item name="chipIconSize">@dimen/icon_sm</item>
        <item name="chipIconTint">@color/ink</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textAppearance">@style/TextAppearance.NoCuelgues.BodyStrong</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.NoCuelgues.Small</item>
        <item name="rippleColor">@android:color/transparent</item>
    </style>

    <style name="Widget.NoCuelgues.Tag" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/surface</item>
        <item name="chipStrokeColor">@color/ink</item>
        <item name="chipStrokeWidth">@dimen/stroke_thin</item>
        <item name="chipMinHeight">28dp</item>
        <item name="chipIconVisible">false</item>
        <item name="ensureMinTouchTargetSize">false</item>
        <item name="android:clickable">false</item>
        <item name="android:checkable">false</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textAppearance">@style/TextAppearance.NoCuelgues.Label</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.NoCuelgues.ExtraSmall</item>
        <item name="rippleColor">@android:color/transparent</item>
    </style>

    <style name="Widget.NoCuelgues.UrgencyOption" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/touch_target</item>
        <item name="android:layout_weight">1</item>
        <item name="android:button">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textAppearance">@style/TextAppearance.NoCuelgues.Option</item>
    </style>

    <style name="Widget.NoCuelgues.Badge" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textAppearance">@style/TextAppearance.NoCuelgues.Badge</item>
    </style>

</resources>
