<resources>

    <style name="Base.Theme.NoCuelguesApp" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/ink</item>
        <item name="colorOnPrimary">@color/surface</item>
        <item name="colorSecondary">@color/brand</item>
        <item name="colorError">@color/error</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:fontFamily">@font/space_grotesk_medium</item>
        <item name="fontFamily">@font/space_grotesk_medium</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.NoCuelguesApp" parent="Base.Theme.NoCuelguesApp" />

    <!-- Pantalla de carga del sistema solo con el fondo: el ícono que permite Android es chico (lo recorta
         un círculo de 192dp), así que el logo grande lo muestra MainActivity en layout_splash. -->
    <style name="Theme.NoCuelguesApp.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/paper</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.NoCuelguesApp</item>
    </style>

</resources>
