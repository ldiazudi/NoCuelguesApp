<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_xl"
    android:paddingTop="@dimen/space_xl"
    android:paddingEnd="26dp"
    android:paddingBottom="26dp">

    <!-- 52dp square plus its 2dp shadow -->
    <FrameLayout
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/bg_dialog_icon"
        android:paddingEnd="@dimen/shadow_sm"
        android:paddingBottom="@dimen/shadow_sm">

        <ImageView
            android:layout_width="@dimen/icon_md"
            android:layout_height="@dimen/icon_md"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_delete" />
    </FrameLayout>

    <TextView
        android:id="@+id/text_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:textAppearance="@style/TextAppearance.NoCuelgues.Headline"
        tools:text="¿Eliminar &quot;Pasaporte&quot;?" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:text="@string/dialog_delete_body"
        android:textAppearance="@style/TextAppearance.NoCuelgues.Body" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_cancel"
            style="@style/Widget.NoCuelgues.Button.Small.Surface"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/action_cancel" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_confirm_delete"
            style="@style/Widget.NoCuelgues.Button.Small.Danger"
            android:layout_width="0dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/action_delete" />
    </LinearLayout>

</LinearLayout>
