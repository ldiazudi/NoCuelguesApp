<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="vertical"
    tools:context=".presentation.FormActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_lg"
            android:paddingTop="10dp"
            android:paddingEnd="@dimen/space_lg"
            android:paddingBottom="@dimen/space_xxl">

            <!-- Encabezado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="@dimen/space_xl">

                <ImageButton
                    android:id="@+id/button_back"
                    style="@style/Widget.NoCuelgues.IconButton"
                    android:contentDescription="@string/action_back"
                    android:src="@drawable/ic_arrow_back" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_item_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.NoCuelgues.Label"
                        android:textColor="@color/text_secondary"
                        android:visibility="gone"
                        tools:text="Pasaporte"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/text_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/form_title_new"
                        android:textAppearance="@style/TextAppearance.NoCuelgues.Headline" />
                </LinearLayout>
            </LinearLayout>

            <!-- Nombre -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/Widget.NoCuelgues.FieldLabel"
                    android:labelFor="@id/input_name"
                    android:text="@string/field_name" />

                <TextView
                    android:id="@+id/text_name_counter"
                    style="@style/Widget.NoCuelgues.FieldCounter"
                    tools:text="9/40" />
            </LinearLayout>

            <EditText
                android:id="@+id/input_name"
                style="@style/Widget.NoCuelgues.Input"
                android:layout_height="wrap_content"
                android:hint="@string/field_name_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLength="@integer/name_max_length"
                android:maxLines="1" />

            <TextView
                android:id="@+id/text_name_error"
                style="@style/Widget.NoCuelgues.FieldError"
                android:drawableStart="@drawable/ic_error"
                android:text="@string/error_name_required" />

            <!-- Fecha de vencimiento -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:orientation="horizontal">

                <TextView
                    style="@style/Widget.NoCuelgues.FieldLabel"
                    android:labelFor="@id/input_date"
                    android:text="@string/field_date" />
            </LinearLayout>

            <TextView
                android:id="@+id/input_date"
                style="@style/Widget.NoCuelgues.Input"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:drawableEnd="@drawable/ic_calendar_month"
                android:focusable="true"
                android:hint="@string/field_date_hint" />

            <TextView
                android:id="@+id/text_days_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_pill"
                android:drawableStart="@drawable/ic_hourglass_bottom"
                android:drawablePadding="@dimen/space_xs"
                android:gravity="center_vertical"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:textAppearance="@style/TextAppearance.NoCuelgues.BodyStrong"
                android:visibility="gone"
                tools:text="Faltan 18 días"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/text_date_error"
                style="@style/Widget.NoCuelgues.FieldError"
                android:drawableStart="@drawable/ic_error"
                android:text="@string/error_date_required" />

            <!-- Recordatorio -->
            <LinearLayout
                android:id="@+id/layout_reminder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:background="@drawable/bg_callout"
                android:orientation="vertical"
                android:paddingStart="@dimen/field_padding_horizontal"
                android:paddingTop="@dimen/space_md"
                android:paddingEnd="@dimen/field_padding_horizontal"
                android:paddingBottom="@dimen/space_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_logo_small" />

                    <!-- AppCompatCheckBox y no CheckBox: el tema convierte CheckBox en MaterialCheckBox,
                         que dibuja su propia casilla encima de indicator_checkbox. -->
                    <androidx.appcompat.widget.AppCompatCheckBox
                        android:id="@+id/input_reminder_enabled"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:background="@null"
                        android:button="@null"
                        android:checked="true"
                        android:drawableEnd="@drawable/indicator_checkbox"
                        android:drawablePadding="@dimen/space_md"
                        android:minHeight="@dimen/touch_target"
                        android:text="@string/reminder_enabled"
                        android:textAppearance="@style/TextAppearance.NoCuelgues.Title" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_reminder_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:labelFor="@id/input_reminder_days"
                                android:text="@string/reminder_days"
                                android:textAppearance="@style/TextAppearance.NoCuelgues.Label" />

                            <EditText
                                android:id="@+id/input_reminder_days"
                                style="@style/Widget.NoCuelgues.Input"
                                android:layout_height="wrap_content"
                                android:importantForAutofill="no"
                                android:inputType="number"
                                android:maxLength="@integer/reminder_days_max_length"
                                android:maxLines="1" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:labelFor="@id/input_reminder_time"
                                android:text="@string/reminder_time"
                                android:textAppearance="@style/TextAppearance.NoCuelgues.Label" />

                            <TextView
                                android:id="@+id/input_reminder_time"
                                style="@style/Widget.NoCuelgues.Input"
                                android:layout_height="wrap_content"
                                android:clickable="true"
                                android:drawableEnd="@drawable/ic_schedule"
                                android:focusable="true"
                                tools:text="09:00" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/text_reminder_error"
                        style="@style/Widget.NoCuelgues.FieldError"
                        android:drawableStart="@drawable/ic_error" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="@string/reminder_help"
                        android:textAppearance="@style/TextAppearance.NoCuelgues.Caption" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/button_notification_settings"
                        style="@style/Widget.NoCuelgues.Button.Small.Surface"
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="@string/reminder_settings" />
                </LinearLayout>
            </LinearLayout>

            <!-- Categoría -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/field_category"
                android:textAppearance="@style/TextAppearance.NoCuelgues.Label" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:chipSpacingHorizontal="@dimen/space_sm"
                app:chipSpacingVertical="0dp"
                app:selectionRequired="true"
                app:singleSelection="true" />

            <!-- Urgencia -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/field_urgency"
                android:textAppearance="@style/TextAppearance.NoCuelgues.Label" />

            <RadioGroup
                android:id="@+id/radio_group_urgency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_segmented"
                android:checkedButton="@id/radio_urgency_medium"
                android:orientation="horizontal"
                android:padding="@dimen/stroke">

                <RadioButton
                    android:id="@+id/radio_urgency_high"
                    style="@style/Widget.NoCuelgues.UrgencyOption"
                    android:background="@drawable/bg_urgency_option_high"
                    android:drawableStart="@drawable/indicator_urgency_high"
                    android:text="@string/urgency_high" />

                <View
                    android:layout_width="@dimen/stroke"
                    android:layout_height="match_parent"
                    android:background="@color/ink" />

                <RadioButton
                    android:id="@+id/radio_urgency_medium"
                    style="@style/Widget.NoCuelgues.UrgencyOption"
                    android:background="@drawable/bg_urgency_option_medium"
                    android:drawableStart="@drawable/indicator_urgency_medium"
                    android:text="@string/urgency_medium" />

                <View
                    android:layout_width="@dimen/stroke"
                    android:layout_height="match_parent"
                    android:background="@color/ink" />

                <RadioButton
                    android:id="@+id/radio_urgency_low"
                    style="@style/Widget.NoCuelgues.UrgencyOption"
                    android:background="@drawable/bg_urgency_option_low"
                    android:drawableStart="@drawable/indicator_urgency_low"
                    android:text="@string/urgency_low" />
            </RadioGroup>

            <!-- Nota -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:orientation="horizontal">

                <TextView
                    style="@style/Widget.NoCuelgues.FieldLabel"
                    android:labelFor="@id/input_note"
                    android:text="@string/field_note" />

                <TextView
                    android:id="@+id/text_note_counter"
                    style="@style/Widget.NoCuelgues.FieldCounter"
                    tools:text="Opcional · 42/120" />
            </LinearLayout>

            <EditText
                android:id="@+id/input_note"
                style="@style/Widget.NoCuelgues.Input"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="@integer/note_max_length"
                android:minLines="3"
                android:paddingTop="@dimen/space_md"
                android:paddingBottom="16dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Barra de acciones -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke"
        android:background="@color/ink" />

    <LinearLayout
        android:id="@+id/layout_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/paper"
        android:orientation="horizontal"
        android:padding="@dimen/space_lg">

        <ImageButton
            android:id="@+id/button_delete"
            android:layout_width="@dimen/button_height"
            android:layout_height="@dimen/button_height"
            android:layout_marginEnd="@dimen/space_md"
            android:background="@drawable/bg_button_surface"
            android:contentDescription="@string/action_delete"
            android:paddingEnd="@dimen/shadow"
            android:paddingBottom="@dimen/shadow"
            android:scaleType="center"
            android:src="@drawable/ic_delete"
            android:stateListAnimator="@null"
            android:visibility="gone"
            app:tint="@color/error"
            tools:visibility="visible" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_save"
            style="@style/Widget.NoCuelgues.Button"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_check"
            android:text="@string/action_save" />
    </LinearLayout>

</LinearLayout>
