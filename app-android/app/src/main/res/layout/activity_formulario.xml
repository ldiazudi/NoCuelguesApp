<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Encabezado -->
    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="18dp"
        android:text="@string/form_title_new"
        android:textSize="26sp"
        android:textStyle="bold" />

    <!-- Campos que pueden desplazarse -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:labelFor="@id/edtNombre"
                android:text="@string/field_name"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="@string/field_name_hint"
                android:inputType="textCapSentences"
                android:maxLength="40"
                android:maxLines="1"
                android:minHeight="52dp"
                android:padding="14dp"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/field_date"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnFecha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:backgroundTint="@null"
                android:minHeight="52dp"
                android:padding="14dp"
                android:gravity="start|center_vertical"
                android:text="@string/field_date_hint"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/txtDiasRestantes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill"
                android:padding="6dp"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:labelFor="@id/spCategoria"
                android:text="@string/field_category"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spCategoria"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:entries="@array/categorias"
                android:padding="8dp"
                android:spinnerMode="dropdown" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/field_urgency"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgUrgencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:checkedButton="@id/rbMedia"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbAlta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="@color/urgency_high"
                    android:minHeight="48dp"
                    android:text="@string/urgency_high"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbMedia"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="@color/urgency_medium"
                    android:minHeight="48dp"
                    android:text="@string/urgency_medium"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbBaja"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="@color/urgency_low"
                    android:minHeight="48dp"
                    android:text="@string/urgency_low"
                    android:textSize="14sp" />

            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:labelFor="@id/edtNota"
                android:text="@string/form_note_optional_label"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtNota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:gravity="top|start"
                android:hint="@string/form_note_hint"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="120"
                android:minLines="3"
                android:padding="14dp"
                android:textSize="16sp" />

        </LinearLayout>
    </ScrollView>

    <!-- Botones fijos al pie -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="18dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnVolver"
            style="@style/Widget.NoCuelgues.Button"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:text="@string/action_back" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnGuardar"
            style="@style/Widget.NoCuelgues.Button"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/action_save" />

    </LinearLayout>

</LinearLayout>