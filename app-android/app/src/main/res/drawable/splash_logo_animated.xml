<?xml version="1.0" encoding="utf-8"?>
<!-- Balanceo de las hojas del logo en la pantalla de carga: oscilan alrededor del gancho y se frenan.
     Cada tramo acelera y desacelera como un péndulo. Android 8 a 11 muestra splash_logo sin animación.
     Si se cambia la duración, actualizar también windowSplashScreenAnimationDuration en themes.xml
     y SPLASH_ANIMATION_MS en MainActivity. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/splash_logo">

    <target android:name="sheets">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="1400"
                android:interpolator="@android:anim/linear_interpolator">
                <propertyValuesHolder android:propertyName="rotation">
                    <keyframe
                        android:fraction="0"
                        android:value="0" />
                    <keyframe
                        android:fraction="0.16"
                        android:interpolator="@android:anim/decelerate_interpolator"
                        android:value="9" />
                    <keyframe
                        android:fraction="0.38"
                        android:interpolator="@android:anim/accelerate_decelerate_interpolator"
                        android:value="-6" />
                    <keyframe
                        android:fraction="0.6"
                        android:interpolator="@android:anim/accelerate_decelerate_interpolator"
                        android:value="3.5" />
                    <keyframe
                        android:fraction="0.8"
                        android:interpolator="@android:anim/accelerate_decelerate_interpolator"
                        android:value="-1.5" />
                    <keyframe
                        android:fraction="1"
                        android:interpolator="@android:anim/accelerate_decelerate_interpolator"
                        android:value="0" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
</animated-vector>
