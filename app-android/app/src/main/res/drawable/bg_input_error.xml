<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="@dimen/shadow" android:top="@dimen/shadow">
        <shape android:shape="rectangle">
            <solid android:color="@color/error" />
            <corners android:radius="@dimen/radius_sm" />
        </shape>
    </item>
    <item android:right="@dimen/shadow" android:bottom="@dimen/shadow">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <stroke android:width="@dimen/stroke" android:color="@color/error" />
            <corners android:radius="@dimen/radius_sm" />
        </shape>
    </item>
</layer-list>
