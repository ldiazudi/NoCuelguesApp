<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
                <item android:left="@dimen/shadow" android:top="@dimen/shadow">
                    <shape android:shape="rectangle">
                        <solid android:color="@color/ink" />
                        <corners android:radius="@dimen/radius_lg" />
                    </shape>
                </item>
                <item android:left="@dimen/shadow_sm" android:top="@dimen/shadow_sm" android:right="@dimen/shadow_sm" android:bottom="@dimen/shadow_sm">
                    <shape android:shape="rectangle">
                        <solid android:color="@color/brand" />
                        <stroke android:width="@dimen/stroke" android:color="@color/ink" />
                        <corners android:radius="@dimen/radius_lg" />
                    </shape>
                </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
                <item android:left="@dimen/shadow" android:top="@dimen/shadow">
                    <shape android:shape="rectangle">
                        <solid android:color="@color/ink" />
                        <corners android:radius="@dimen/radius_lg" />
                    </shape>
                </item>
                <item android:right="@dimen/shadow" android:bottom="@dimen/shadow">
                    <shape android:shape="rectangle">
                        <solid android:color="@color/brand" />
                        <stroke android:width="@dimen/stroke" android:color="@color/ink" />
                        <corners android:radius="@dimen/radius_lg" />
                    </shape>
                </item>
        </layer-list>
    </item>
</selector>
